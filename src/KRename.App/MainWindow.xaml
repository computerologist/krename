<Window x:Class="KRename.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:KRename.Core;assembly=KRename.Core"
        Title="KRename" Width="1380" Height="900" MinWidth="1050" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="#F4F4F8" KeyDown="Window_KeyDown" Closing="Window_Closing">
    <Window.Resources>
        <ContextMenu x:Key="ColumnChooserContextMenu" x:Shared="False" Opened="ColumnChooserContextMenu_Opened">
            <MenuItem Header="Subfolder" Tag="Subfolder" IsCheckable="True" Click="ColumnVisibility_Click" />
            <MenuItem Header="Size" Tag="Size" IsCheckable="True" Click="ColumnVisibility_Click" />
            <MenuItem Header="Created" Tag="Created" IsCheckable="True" Click="ColumnVisibility_Click" />
            <MenuItem Header="Modified" Tag="Modified" IsCheckable="True" Click="ColumnVisibility_Click" />
            <MenuItem Header="Read only" Tag="ReadOnly" IsCheckable="True" Click="ColumnVisibility_Click" />
            <MenuItem Header="Hidden" Tag="Hidden" IsCheckable="True" Click="ColumnVisibility_Click" />
        </ContextMenu>
        <Style x:Key="ColumnHeaderChooserStyle" TargetType="DataGridColumnHeader">
            <Setter Property="ContextMenu" Value="{StaticResource ColumnChooserContextMenu}" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="210" />
            <RowDefinition Height="305" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Background="#F8F8FA" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="5,2">
            <MenuItem Header="_File">
                <MenuItem Header="_Load folder…" Click="BrowseButton_Click" InputGestureText="Ctrl+O" />
                <MenuItem Header="_Refresh file list" Click="PreviewButton_Click" InputGestureText="F5" />
                <Separator />
                <MenuItem Header="E_xit" Click="ExitMenu_Click" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem x:Name="UndoMenuItem" Header="_Undo last rename" Click="UndoButton_Click" InputGestureText="Ctrl+Z" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Columns">
                    <MenuItem x:Name="ViewSubfolderMenuItem" Header="_Subfolder" Tag="Subfolder" IsCheckable="True" Click="ColumnVisibility_Click" />
                    <MenuItem x:Name="ViewSizeMenuItem" Header="_Size" Tag="Size" IsCheckable="True" Click="ColumnVisibility_Click" />
                    <MenuItem x:Name="ViewCreatedMenuItem" Header="_Created" Tag="Created" IsCheckable="True" Click="ColumnVisibility_Click" />
                    <MenuItem x:Name="ViewModifiedMenuItem" Header="_Modified" Tag="Modified" IsCheckable="True" Click="ColumnVisibility_Click" />
                    <MenuItem x:Name="ViewReadOnlyMenuItem" Header="_Read only" Tag="ReadOnly" IsCheckable="True" Click="ColumnVisibility_Click" />
                    <MenuItem x:Name="ViewHiddenMenuItem" Header="_Hidden" Tag="Hidden" IsCheckable="True" Click="ColumnVisibility_Click" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Run">
                <MenuItem Header="_Refresh preview" Click="PreviewButton_Click" InputGestureText="F5" />
                <MenuItem x:Name="ApplyMenuItem" Header="_Apply rename" Click="ApplyButton_Click" IsEnabled="False" />
            </MenuItem>
            <MenuItem Header="_Options">
                <MenuItem Header="_Settings…" Click="SettingsMenu_Click" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About KRename" Click="AboutMenu_Click" />
            </MenuItem>
        </Menu>

        <Border Grid.Row="1" Margin="16,12,16,8" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="260" /><ColumnDefinition Width="*" MinWidth="140" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="FolderComboBox" Grid.Column="0" IsEditable="True" IsTextSearchEnabled="False" MinHeight="34"
                          VerticalContentAlignment="Center" ToolTip="Source directory; previous folders are available in the dropdown" KeyDown="RefreshField_KeyDown" />
                <ComboBox x:Name="MaskTextBox" Grid.Column="1" Text="*.*" IsEditable="True" IsTextSearchEnabled="False" Margin="10,0,0,0"
                          ToolTip="File mask; use semicolons for multiple masks" KeyDown="RefreshField_KeyDown" />
                <CheckBox x:Name="RecursiveCheckBox" Grid.Column="2" Content="Recurse into subfolders" Margin="16,0,6,0" />
                <Button Grid.Column="3" Content="Browse folder…" Style="{StaticResource SecondaryButton}" Click="BrowseButton_Click" />
                <Button x:Name="LoadRefreshButton" Grid.Column="4" Content="Load / refresh files" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="PreviewButton_Click" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="16,0,16,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#ECEBF5" Padding="12,8" CornerRadius="8,8,0,0">
                        <TextBlock Text="BEFORE — source files" FontWeight="SemiBold" Foreground="#39374D" />
                    </Border>
                    <DataGrid x:Name="SourceGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" BorderThickness="0"
                              GridLinesVisibility="Horizontal" AlternatingRowBackground="#F8F8FB" RowHeaderWidth="0"
                              ColumnHeaderStyle="{StaticResource ColumnHeaderChooserStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="File name" Binding="{Binding CurrentName}" Width="1.5*" />
                            <DataGridTextColumn x:Name="SourceSubfolderColumn" Header="Subfolder" Binding="{Binding RelativeDirectory}" Width="*" />
                            <DataGridTextColumn x:Name="SourceSizeColumn" Header="Size" Binding="{Binding FileSizeDisplay}" Width="78" />
                            <DataGridTextColumn x:Name="SourceCreatedColumn" Header="Created" Binding="{Binding CreatedAt, StringFormat={}{0:g}}" Width="125" />
                            <DataGridTextColumn x:Name="SourceModifiedColumn" Header="Modified" Binding="{Binding ModifiedAt, StringFormat={}{0:g}}" Width="125" />
                            <DataGridCheckBoxColumn x:Name="SourceReadOnlyColumn" Header="Read only" Binding="{Binding IsReadOnly}" Width="72" />
                            <DataGridCheckBoxColumn x:Name="SourceHiddenColumn" Header="Hidden" Binding="{Binding IsHidden}" Width="60" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />
            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#E8E5FF" Padding="12,8" CornerRadius="8,8,0,0">
                        <TextBlock Text="AFTER — rename preview" FontWeight="SemiBold" Foreground="#493AAF" />
                    </Border>
                    <DataGrid x:Name="PreviewGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" BorderThickness="0"
                              GridLinesVisibility="Horizontal" AlternatingRowBackground="#F8F8FB" RowHeaderWidth="0"
                              ColumnHeaderStyle="{StaticResource ColumnHeaderChooserStyle}">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="ToolTip" Value="{Binding Message}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static core:RenameStatus.Ready}">
                                        <Setter Property="Background" Value="#E5F6E9" />
                                        <Setter Property="Foreground" Value="#166534" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static core:RenameStatus.Error}">
                                        <Setter Property="Background" Value="#FDE8E8" />
                                        <Setter Property="Foreground" Value="#A11212" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static core:RenameStatus.Unchanged}">
                                        <Setter Property="Background" Value="#EEEEF2" />
                                        <Setter Property="Foreground" Value="#6A687A" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="New file name" Binding="{Binding NewName}" Width="1.5*" />
                            <DataGridTextColumn x:Name="PreviewSubfolderColumn" Header="Subfolder" Binding="{Binding RelativeDirectory}" Width="*" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Message}" Width="140" />
                            <DataGridTextColumn x:Name="PreviewSizeColumn" Header="Size" Binding="{Binding FileSizeDisplay}" Width="78" />
                            <DataGridTextColumn x:Name="PreviewCreatedColumn" Header="Created" Binding="{Binding CreatedAt, StringFormat={}{0:g}}" Width="125" />
                            <DataGridTextColumn x:Name="PreviewModifiedColumn" Header="Modified" Binding="{Binding ModifiedAt, StringFormat={}{0:g}}" Width="125" />
                            <DataGridCheckBoxColumn x:Name="PreviewReadOnlyColumn" Header="Read only" Binding="{Binding IsReadOnly}" Width="72" />
                            <DataGridCheckBoxColumn x:Name="PreviewHiddenColumn" Header="Hidden" Binding="{Binding IsHidden}" Width="60" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" Margin="16,0,16,10" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <TabControl BorderThickness="0" Padding="4">
                <TabItem Header="Filename replacement">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="1.15*" /></Grid.ColumnDefinitions>
                        <GroupBox Grid.Column="0" Header="Whole name and affixes" Margin="0,0,8,0" Padding="10">
                            <StackPanel>
                                <CheckBox x:Name="ReplaceEntireNameCheckBox" Content="Replace entire name" Margin="0,0,0,7" />
                                <ComboBox x:Name="EntireNameTextBox" IsEditable="True" IsTextSearchEnabled="False" ToolTip="New base name before numbering" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,5,0"><TextBlock Text="Prefix" Margin="0,0,0,4" /><ComboBox x:Name="PrefixTextBox" IsEditable="True" IsTextSearchEnabled="False" /></StackPanel>
                                    <StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBlock Text="Suffix" Margin="0,0,0,4" /><ComboBox x:Name="SuffixTextBox" IsEditable="True" IsTextSearchEnabled="False" /></StackPanel>
                                </Grid>
                                <TextBlock Text="Order: replace → cleanup → split/trim → affixes → date/time → numbering" TextWrapping="Wrap" Foreground="#6A687A" FontSize="11" Margin="0,12,0,0" />
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Grid.Column="1" Header="Replace filename characters" Margin="8,0" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <ComboBox x:Name="NameFindTextBox" IsEditable="True" IsTextSearchEnabled="False" ToolTip="Find (spaces are matched literally)" />
                                    <ComboBox x:Name="NameReplaceTextBox" Grid.Column="1" IsEditable="True" IsTextSearchEnabled="False" Margin="6,0" ToolTip="Replace with" />
                                    <Button x:Name="AddNameRuleButton" Grid.Column="2" Content="Add" Style="{StaticResource SecondaryButton}" Click="AddNameRule_Click" />
                                    <CheckBox x:Name="NameRuleCaseSensitiveCheckBox" Grid.Row="1" Grid.ColumnSpan="3" Content="Case-sensitive match" Margin="0,7,0,0" />
                                </Grid>
                                <ListBox x:Name="NameRulesList" Grid.Row="1" Margin="0,8">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid MinWidth="250">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Display}" VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Content="🗑" ToolTip="Remove this filter" Tag="{Binding}" Click="DeleteNameRule_Click"
                                                        MinHeight="22" Padding="5,1" Margin="8,0,0,0" Background="Transparent" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Grid.Row="2" Orientation="Horizontal">
                                    <Button Content="Remove selected" Style="{StaticResource SecondaryButton}" Click="RemoveNameRule_Click" />
                                    <Button Content="Clear all" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="ClearNameRules_Click" />
                                </StackPanel>
                            </Grid>
                        </GroupBox>
                        <GroupBox Grid.Column="2" Header="Case and cleanup" Margin="8,0,0,0" Padding="10">
                            <StackPanel>
                                <TextBlock Text="Filename letter case" Margin="0,0,0,6" />
                                <RadioButton x:Name="CaseNoChangeRadio" GroupName="FilenameCase" Content="No case change" IsChecked="True" Margin="0,0,0,6" />
                                <RadioButton x:Name="CaseLowerRadio" GroupName="FilenameCase" Content="Make all lowercase" Margin="0,0,0,6" />
                                <RadioButton x:Name="CaseUpperRadio" GroupName="FilenameCase" Content="Make all uppercase" Margin="0,0,0,6" />
                                <WrapPanel Margin="0,12,0,4">
                                    <CheckBox x:Name="RemoveNumbersCheckBox" Content="Remove numbers" />
                                    <CheckBox x:Name="RemoveLettersCheckBox" Content="Remove letters" />
                                </WrapPanel>
                                <WrapPanel Margin="0,4">
                                    <CheckBox x:Name="RemoveSpacesCheckBox" Content="Remove spaces" />
                                    <CheckBox x:Name="RemoveSymbolsCheckBox" Content="Remove symbols" />
                                </WrapPanel>
                                <Separator Margin="0,8" />
                                <WrapPanel>
                                    <CheckBox x:Name="RegexCheckBox" Content="Rules are regular expressions" />
                                </WrapPanel>
                            </StackPanel>
                        </GroupBox>
                    </Grid>
                </TabItem>

                <TabItem Header="Split, trim and extension">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <GroupBox Grid.Column="0" Header="Split filename by character" Margin="0,0,8,0" Padding="10">
                            <StackPanel>
                                <CheckBox x:Name="SplitEnabledCheckBox" Content="Split filename" />
                                <TextBlock Text="Split character or delimiter" Margin="0,10,0,4" /><ComboBox x:Name="SplitDelimiterTextBox" IsEditable="True" IsTextSearchEnabled="False" />
                                <CheckBox x:Name="SplitCaseSensitiveCheckBox" Content="Case-sensitive delimiter" Margin="0,7,0,0" />
                                <TextBlock Text="Items to keep (for example 1,3,5-7)" Margin="0,10,0,4" /><ComboBox x:Name="SplitItemsTextBox" Text="1" IsEditable="True" IsTextSearchEnabled="False" />
                                <TextBlock Text="Optional new join character" Margin="0,10,0,4" /><ComboBox x:Name="SplitJoinerTextBox" IsEditable="True" IsTextSearchEnabled="False" />
                            </StackPanel>
                        </GroupBox>
                        <StackPanel Grid.Column="1" Margin="8,0">
                            <GroupBox Header="Filename left trim" Padding="10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Action" /><ComboBox x:Name="LeftTrimActionComboBox" SelectedIndex="0"><ComboBoxItem Content="None" /><ComboBoxItem Content="Remove" /><ComboBoxItem Content="Keep" /></ComboBox></StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0"><TextBlock Text="Characters" /><ComboBox x:Name="LeftTrimCountTextBox" Text="0" IsEditable="True" IsTextSearchEnabled="False" /></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="Ignore first" /><ComboBox x:Name="LeftTrimIgnoreTextBox" Text="0" IsEditable="True" IsTextSearchEnabled="False" /></StackPanel>
                                </Grid>
                            </GroupBox>
                            <GroupBox Header="Filename right trim" Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Action" /><ComboBox x:Name="RightTrimActionComboBox" SelectedIndex="0"><ComboBoxItem Content="None" /><ComboBoxItem Content="Remove" /><ComboBoxItem Content="Keep" /></ComboBox></StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0"><TextBlock Text="Characters" /><ComboBox x:Name="RightTrimCountTextBox" Text="0" IsEditable="True" IsTextSearchEnabled="False" /></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="Ignore first" /><ComboBox x:Name="RightTrimIgnoreTextBox" Text="0" IsEditable="True" IsTextSearchEnabled="False" /></StackPanel>
                                </Grid>
                            </GroupBox>
                        </StackPanel>
                        <GroupBox Grid.Column="2" Header="Replace file extension" Margin="8,0,0,0" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <ComboBox x:Name="ExtensionFindTextBox" IsEditable="True" IsTextSearchEnabled="False" ToolTip="Extension without the dot" />
                                    <ComboBox x:Name="ExtensionReplaceTextBox" Grid.Column="1" IsEditable="True" IsTextSearchEnabled="False" Margin="6,0" ToolTip="New extension" />
                                    <Button Grid.Column="2" Content="Add" Style="{StaticResource SecondaryButton}" Click="AddExtensionRule_Click" />
                                    <CheckBox x:Name="ExtensionRuleCaseSensitiveCheckBox" Grid.Row="1" Grid.ColumnSpan="3" Content="Case-sensitive extension match" Margin="0,7,0,0" />
                                </Grid>
                                <ListBox x:Name="ExtensionRulesList" Grid.Row="1" Margin="0,8">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid MinWidth="250">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Display}" VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Content="🗑" ToolTip="Remove this filter" Tag="{Binding}" Click="DeleteExtensionRule_Click"
                                                        MinHeight="22" Padding="5,1" Margin="8,0,0,0" Background="Transparent" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Grid.Row="2" Orientation="Horizontal">
                                    <Button Content="Remove selected" Style="{StaticResource SecondaryButton}" Click="RemoveExtensionRule_Click" />
                                    <Button Content="Clear all" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="ClearExtensionRules_Click" />
                                </StackPanel>
                            </Grid>
                        </GroupBox>
                    </Grid>
                </TabItem>

                <TabItem Header="Date and time">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <GroupBox Grid.Column="0" Header="Date source" Margin="0,0,8,0" Padding="10">
                            <StackPanel>
                                <CheckBox x:Name="UseCurrentDateTimeCheckBox" Content="Use current date and time" IsChecked="True" />
                                <TextBlock Text="Custom date" Margin="0,12,0,4" /><DatePicker x:Name="CustomDatePicker" />
                                <TextBlock Text="Custom time (HH:mm:ss)" Margin="0,10,0,4" /><ComboBox x:Name="CustomTimeTextBox" Text="00:00:00" IsEditable="True" IsTextSearchEnabled="False" />
                                <TextBlock Text="The selected components are appended to the filename. Use the suffix field for a leading separator." TextWrapping="Wrap" Foreground="#6A687A" FontSize="11" Margin="0,12,0,0" />
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Grid.Column="1" Header="Date in filename" Margin="8,0" Padding="10">
                            <StackPanel>
                                <WrapPanel><CheckBox x:Name="AddYearCheckBox" Content="Year" /><CheckBox x:Name="AddMonthCheckBox" Content="Month" /><CheckBox x:Name="AddDayCheckBox" Content="Day" /></WrapPanel>
                                <CheckBox x:Name="YearAtEndCheckBox" Content="Place year at end of date" Margin="0,12,0,0" />
                                <TextBlock Text="Date separator" Margin="0,12,0,4" /><ComboBox x:Name="DateSeparatorTextBox" Text="-" IsEditable="True" IsTextSearchEnabled="False" />
                                <TextBlock Text="Date and time separator" Margin="0,10,0,4" /><ComboBox x:Name="DateTimeSeparatorTextBox" Text="_" IsEditable="True" IsTextSearchEnabled="False" />
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Grid.Column="2" Header="Time in filename" Margin="8,0,0,0" Padding="10">
                            <StackPanel>
                                <WrapPanel><CheckBox x:Name="AddHourCheckBox" Content="Hour" /><CheckBox x:Name="AddMinuteCheckBox" Content="Minute" /><CheckBox x:Name="AddSecondCheckBox" Content="Seconds" /></WrapPanel>
                                <TextBlock Text="Time separator" Margin="0,12,0,4" /><ComboBox x:Name="TimeSeparatorTextBox" Text="-" IsEditable="True" IsTextSearchEnabled="False" />
                            </StackPanel>
                        </GroupBox>
                    </Grid>
                </TabItem>

                <TabItem Header="Consecutive numbering / lettering">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0"><TextBlock Text="Sequence" Margin="0,0,0,4" /><ComboBox x:Name="SequenceKindComboBox" SelectedIndex="0"><ComboBoxItem Content="None" /><ComboBoxItem Content="Numbers" /><ComboBoxItem Content="Letters (A, B … AA)" /></ComboBox></StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0"><TextBlock Text="Start" Margin="0,0,0,4" /><ComboBox x:Name="SequenceStartTextBox" Text="1" IsEditable="True" IsTextSearchEnabled="False" /></StackPanel>
                        <StackPanel Grid.Column="2" Margin="8,0"><TextBlock Text="Number digits" Margin="0,0,0,4" /><ComboBox x:Name="SequenceDigitsTextBox" Text="2" IsEditable="True" IsTextSearchEnabled="False" /></StackPanel>
                        <StackPanel Grid.Column="3" Margin="8,0"><TextBlock Text="Separator" Margin="0,0,0,4" /><ComboBox x:Name="SequenceSeparatorTextBox" IsEditable="True" IsTextSearchEnabled="False" /></StackPanel>
                        <StackPanel Grid.Column="4" Margin="8,0,0,0"><TextBlock Text="Position" Margin="0,0,0,4" /><ComboBox x:Name="SequencePositionComboBox" SelectedIndex="1"><ComboBoxItem Content="Before filename" /><ComboBoxItem Content="After filename" /></ComboBox></StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <Border Grid.Row="4" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusTextBlock" Text="Choose a folder and preview your changes." VerticalAlignment="Center" Foreground="#555466" />
                <Button Grid.Column="1" Content="Refresh preview" Style="{StaticResource SecondaryButton}" Margin="8,0" Click="PreviewButton_Click" />
                <Button x:Name="ApplyButton" Grid.Column="2" Content="Apply rename" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="ApplyButton_Click" IsEnabled="False" />
            </Grid>
        </Border>
    </Grid>
</Window>
