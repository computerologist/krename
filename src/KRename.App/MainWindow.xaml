<Window x:Class="KRename.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:KRename.Core;assembly=KRename.Core"
        xmlns:local="clr-namespace:KRename.App"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="KRename" Width="1480" Height="920" MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen" WindowStyle="None" Background="{DynamicResource WindowBackgroundBrush}" KeyDown="Window_KeyDown" Closing="Window_Closing">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <ContextMenu x:Key="ColumnChooserContextMenu" x:Shared="False" Opened="ColumnChooserContextMenu_Opened">
            <MenuItem Header="Subfolder" Tag="Subfolder" IsCheckable="True" Click="ColumnVisibility_Click" />
            <MenuItem Header="Size" Tag="Size" IsCheckable="True" Click="ColumnVisibility_Click" />
            <MenuItem Header="Created" Tag="Created" IsCheckable="True" Click="ColumnVisibility_Click" />
            <MenuItem Header="Modified" Tag="Modified" IsCheckable="True" Click="ColumnVisibility_Click" />
            <MenuItem Header="Read only" Tag="ReadOnly" IsCheckable="True" Click="ColumnVisibility_Click" />
            <MenuItem Header="Hidden" Tag="Hidden" IsCheckable="True" Click="ColumnVisibility_Click" />
        </ContextMenu>
        <Style x:Key="ColumnHeaderChooserStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="ContextMenu" Value="{StaticResource ColumnChooserContextMenu}" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="32" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <local:ThemedTitleBar />
        <Grid Grid.Row="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" MinHeight="190" />
            <RowDefinition Height="7" />
            <RowDefinition Height="2*" MinHeight="145" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Background="{DynamicResource MenuBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="5,2">
            <MenuItem Header="_File">
                <MenuItem Header="_Load folder…" Click="BrowseButton_Click" InputGestureText="Ctrl+O" />
                <MenuItem Header="_Refresh file list" Click="PreviewButton_Click" InputGestureText="F5" />
                <Separator />
                <MenuItem Header="E_xit" Click="ExitMenu_Click" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem x:Name="UndoMenuItem" Header="_Undo last rename" Click="UndoButton_Click" InputGestureText="Ctrl+Z" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Columns">
                    <MenuItem x:Name="ViewSubfolderMenuItem" Header="_Subfolder" Tag="Subfolder" IsCheckable="True" Click="ColumnVisibility_Click" />
                    <MenuItem x:Name="ViewSizeMenuItem" Header="_Size" Tag="Size" IsCheckable="True" Click="ColumnVisibility_Click" />
                    <MenuItem x:Name="ViewCreatedMenuItem" Header="_Created" Tag="Created" IsCheckable="True" Click="ColumnVisibility_Click" />
                    <MenuItem x:Name="ViewModifiedMenuItem" Header="_Modified" Tag="Modified" IsCheckable="True" Click="ColumnVisibility_Click" />
                    <MenuItem x:Name="ViewReadOnlyMenuItem" Header="_Read only" Tag="ReadOnly" IsCheckable="True" Click="ColumnVisibility_Click" />
                    <MenuItem x:Name="ViewHiddenMenuItem" Header="_Hidden" Tag="Hidden" IsCheckable="True" Click="ColumnVisibility_Click" />
                </MenuItem>
                <Separator />
                <MenuItem x:Name="ViewDarkModeMenuItem" Header="_Dark mode" IsCheckable="True" Click="ThemeToggle_Click" />
            </MenuItem>
            <MenuItem Header="_Run">
                <MenuItem Header="_Refresh preview" Click="PreviewButton_Click" InputGestureText="F5" />
                <MenuItem x:Name="ApplyMenuItem" Header="_Apply rename" Click="ApplyButton_Click" IsEnabled="False" />
            </MenuItem>
            <MenuItem Header="_Options">
                <MenuItem Header="_Settings…" Click="SettingsMenu_Click" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About KRename" Click="AboutMenu_Click" />
            </MenuItem>
        </Menu>

        <Border Grid.Row="1" Margin="16,12,16,8" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="220" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="File mask / search pattern" Margin="2,0,0,5" Foreground="{DynamicResource TextSecondaryBrush}" />
                <ComboBox x:Name="MaskTextBox" Grid.Row="1" Grid.Column="0" Text="*.*" IsEditable="True" IsTextSearchEnabled="False"
                          ToolTip="File mask; use semicolons for multiple masks" KeyDown="RefreshField_KeyDown"
                          DropDownClosed="Mask_DropDownClosed" />
                <CheckBox x:Name="RecursiveCheckBox" Grid.Row="1" Grid.Column="1" Content="Include subfolders" Margin="16,0,6,0" />
                <Button x:Name="LoadRefreshButton" Grid.Row="1" Grid.Column="2" Content="Load / refresh files" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="PreviewButton_Click" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="16,0,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="235" MinWidth="170" />
                <ColumnDefinition Width="7" />
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderBrush}" Padding="12,8" CornerRadius="8,8,0,0">
                        <TextBlock Text="FOLDERS" FontWeight="SemiBold" />
                    </Border>
                    <TreeView x:Name="FolderTree" ItemsSource="{Binding FolderRoots}" TreeViewItem.Expanded="FolderTreeItem_Expanded"
                              PreviewMouseRightButtonDown="FolderTree_PreviewMouseRightButtonDown">
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Use as source folder" Click="UseTreeFolderAsSource_Click" />
                                <MenuItem Header="Use as output folder" Click="UseTreeFolderAsOutput_Click" />
                                <Separator />
                                <MenuItem Header="Open folder in Explorer" Click="OpenTreeFolderInExplorer_Click" />
                            </ContextMenu>
                        </TreeView.ContextMenu>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding IconGlyph}" FontFamily="Segoe UI Emoji" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding DisplayName}" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                        <Setter Property="Foreground" Value="White" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="1" Width="7" HorizontalAlignment="Stretch" Background="Transparent" />
            <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="10,9,10,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ComboBox x:Name="FolderComboBox" IsEditable="True" IsTextSearchEnabled="False" MinHeight="34"
                                  VerticalContentAlignment="Center" ToolTip="Source folder; press Enter to load" KeyDown="RefreshField_KeyDown"
                                  DropDownClosed="SourceFolder_DropDownClosed" />
                        <Button Grid.Column="1" Content="Browse…" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="BrowseButton_Click" />
                    </Grid>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource BeforeHeaderBrush}" Padding="12,8">
                        <TextBlock Text="Source" FontWeight="SemiBold" />
                    </Border>
                    <DataGrid x:Name="SourceGrid" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False" BorderThickness="0"
                              GridLinesVisibility="Horizontal" AlternatingRowBackground="{DynamicResource AlternateRowBrush}" RowHeaderWidth="0"
                              ColumnHeaderStyle="{StaticResource ColumnHeaderChooserStyle}" MouseDoubleClick="SourceGrid_MouseDoubleClick"
                              CellEditEnding="SourceGrid_CellEditEnding" PreviewMouseRightButtonDown="SourceGrid_PreviewMouseRightButtonDown">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Show this file in Explorer" Click="OpenSelectedFileInExplorer_Click" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn x:Name="SourceFileNameColumn" Header="File name" Width="1.5*">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding CurrentName}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate><DataTemplate><TextBox Text="{Binding CurrentName, Mode=OneWay}" /></DataTemplate></DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn x:Name="SourceSubfolderColumn" IsReadOnly="True" Header="Subfolder" Binding="{Binding RelativeDirectory}" Width="*" />
                            <DataGridTextColumn x:Name="SourceSizeColumn" IsReadOnly="True" Header="Size" Binding="{Binding FileSizeDisplay}" Width="78" />
                            <DataGridTextColumn x:Name="SourceCreatedColumn" IsReadOnly="True" Header="Created" Binding="{Binding CreatedAt, StringFormat={}{0:g}}" Width="125" />
                            <DataGridTextColumn x:Name="SourceModifiedColumn" IsReadOnly="True" Header="Modified" Binding="{Binding ModifiedAt, StringFormat={}{0:g}}" Width="125" />
                            <DataGridCheckBoxColumn x:Name="SourceReadOnlyColumn" IsReadOnly="True" Header="Read only" Binding="{Binding IsReadOnly}" Width="72" />
                            <DataGridCheckBoxColumn x:Name="SourceHiddenColumn" IsReadOnly="True" Header="Hidden" Binding="{Binding IsHidden}" Width="60" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="3" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />
            <Border Grid.Column="4" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="10,9,10,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ComboBox x:Name="DestinationComboBox" IsEditable="True" IsTextSearchEnabled="False" MinHeight="34"
                                  ToolTip="Manual output folder" KeyDown="RefreshField_KeyDown" DropDownClosed="OutputFolder_DropDownClosed" />
                        <Button x:Name="OutputBrowseButton" Grid.Column="1" Content="Browse…" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="BrowseOutputButton_Click" />
                        <CheckBox x:Name="UseSourceOutputCheckBox" Grid.Column="2" Content="Use source" Margin="10,0,2,0"
                                  ToolTip="Checked: output follows the source folder automatically. Unchecked: choose a separate output folder."
                                  Click="UseSourceOutput_Click" />
                    </Grid>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource AfterHeaderBrush}" Padding="12,8">
                        <TextBlock Text="Target Preview" FontWeight="SemiBold" />
                    </Border>
                    <DataGrid x:Name="PreviewGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" BorderThickness="0"
                              GridLinesVisibility="Horizontal" RowHeaderWidth="0"
                              AlternationCount="2" ColumnHeaderStyle="{StaticResource ColumnHeaderChooserStyle}" PreviewMouseRightButtonDown="PreviewGrid_PreviewMouseRightButtonDown">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Skip" Click="SkipTargetFile_Click" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Setter Property="ToolTip" Value="{Binding Message}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static core:RenameStatus.Ready}">
                                        <Setter Property="Foreground" Value="{DynamicResource ReadyForegroundBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static core:RenameStatus.Error}">
                                        <Setter Property="Foreground" Value="{DynamicResource ErrorForegroundBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static core:RenameStatus.Unchanged}">
                                        <Setter Property="Foreground" Value="{DynamicResource UnchangedForegroundBrush}" />
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions><Condition Binding="{Binding Status}" Value="{x:Static core:RenameStatus.Ready}" /><Condition Binding="{Binding AlternationIndex, RelativeSource={RelativeSource Self}}" Value="0" /></MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="{DynamicResource ReadyBackgroundBrush}" />
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions><Condition Binding="{Binding Status}" Value="{x:Static core:RenameStatus.Ready}" /><Condition Binding="{Binding AlternationIndex, RelativeSource={RelativeSource Self}}" Value="1" /></MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="{DynamicResource ReadyAlternateBackgroundBrush}" />
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions><Condition Binding="{Binding Status}" Value="{x:Static core:RenameStatus.Error}" /><Condition Binding="{Binding AlternationIndex, RelativeSource={RelativeSource Self}}" Value="0" /></MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="{DynamicResource ErrorBackgroundBrush}" />
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions><Condition Binding="{Binding Status}" Value="{x:Static core:RenameStatus.Error}" /><Condition Binding="{Binding AlternationIndex, RelativeSource={RelativeSource Self}}" Value="1" /></MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="{DynamicResource ErrorAlternateBackgroundBrush}" />
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions><Condition Binding="{Binding Status}" Value="{x:Static core:RenameStatus.Unchanged}" /><Condition Binding="{Binding AlternationIndex, RelativeSource={RelativeSource Self}}" Value="0" /></MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="{DynamicResource UnchangedBackgroundBrush}" />
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions><Condition Binding="{Binding Status}" Value="{x:Static core:RenameStatus.Unchanged}" /><Condition Binding="{Binding AlternationIndex, RelativeSource={RelativeSource Self}}" Value="1" /></MultiDataTrigger.Conditions>
                                        <Setter Property="Background" Value="{DynamicResource UnchangedAlternateBackgroundBrush}" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="New file name" Binding="{Binding NewName}" Width="1.5*" />
                            <DataGridTextColumn x:Name="PreviewSubfolderColumn" Header="Subfolder" Binding="{Binding RelativeDirectory}" Width="*" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Message}" Width="140" />
                            <DataGridTextColumn x:Name="PreviewSizeColumn" Header="Size" Binding="{Binding FileSizeDisplay}" Width="78" />
                            <DataGridTextColumn x:Name="PreviewCreatedColumn" Header="Created" Binding="{Binding CreatedAt, StringFormat={}{0:g}}" Width="125" />
                            <DataGridTextColumn x:Name="PreviewModifiedColumn" Header="Modified" Binding="{Binding ModifiedAt, StringFormat={}{0:g}}" Width="125" />
                            <DataGridCheckBoxColumn x:Name="PreviewReadOnlyColumn" Header="Read only" Binding="{Binding IsReadOnly}" Width="72" />
                            <DataGridCheckBoxColumn x:Name="PreviewHiddenColumn" Header="Hidden" Binding="{Binding IsHidden}" Width="60" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <GridSplitter x:Name="OptionsPanelSplitter" Grid.Row="3" Height="7" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource BorderBrush}" Margin="16,0" />

        <Border Grid.Row="4" Margin="16,0,16,10" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <TabControl BorderThickness="0" Padding="4">
                <TabItem Header="Filename replacement">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="1.15*" /></Grid.ColumnDefinitions>
                        <GroupBox Grid.Column="0" Header="Whole name and affixes" Margin="0,0,8,0" Padding="10">
                            <StackPanel>
                                <CheckBox x:Name="ReplaceEntireNameCheckBox" Content="Replace entire name" Margin="0,0,0,7" />
                                <ComboBox x:Name="EntireNameTextBox" IsEditable="True" IsTextSearchEnabled="False" ToolTip="New base name before numbering" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,5,0"><TextBlock Text="Prefix" Margin="0,0,0,4" /><ComboBox x:Name="PrefixTextBox" IsEditable="True" IsTextSearchEnabled="False" /></StackPanel>
                                    <StackPanel Grid.Column="1" Margin="5,0,0,0"><TextBlock Text="Suffix" Margin="0,0,0,4" /><ComboBox x:Name="SuffixTextBox" IsEditable="True" IsTextSearchEnabled="False" /></StackPanel>
                                </Grid>
                                <TextBlock Text="Order: replace → cleanup → split/trim → affixes → date/time → numbering" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,12,0,0" />
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Grid.Column="1" Header="Replace filename characters" Margin="8,0" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <ComboBox x:Name="NameFindTextBox" IsEditable="True" IsTextSearchEnabled="False" ToolTip="Find (spaces are matched literally)" KeyDown="NameRuleField_KeyDown" />
                                    <ComboBox x:Name="NameReplaceTextBox" Grid.Column="1" IsEditable="True" IsTextSearchEnabled="False" Margin="6,0" ToolTip="Replace with" KeyDown="NameRuleField_KeyDown" />
                                    <Button x:Name="AddNameRuleButton" Grid.Column="2" Content="Add" Style="{StaticResource SecondaryButton}" Click="AddNameRule_Click" />
                                    <WrapPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,7,0,0">
                                        <CheckBox x:Name="NameRuleCaseSensitiveCheckBox" Content="Case-sensitive match" />
                                        <CheckBox x:Name="NameRuleRegexCheckBox" Content="Regular expression" Margin="14,0,0,0"
                                                  ToolTip="The pattern applies to the filename without its extension. Example: google[.]com\s+-\s+\[[^]]+\]" />
                                    </WrapPanel>
                                </Grid>
                                <ListBox x:Name="NameRulesList" Grid.Row="1" Margin="0,8">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid MinWidth="250">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Display}" VerticalAlignment="Center" />
                                                <CheckBox Grid.Column="1" Content=".*" ToolTip="Treat this filter as a regular expression" Tag="{Binding}"
                                                          IsChecked="{Binding UseRegex, Mode=TwoWay}" Click="RuleOptionChanged_Click" Margin="7,0,2,0" />
                                                <Button Grid.Column="2" Content="↥" ToolTip="Load this filter into the fields above" Tag="{Binding}" Click="LoadNameRule_Click"
                                                        MinHeight="22" Padding="5,1" Margin="2,0" Background="Transparent" />
                                                <Button Grid.Column="3" Content="▲" ToolTip="Move filter up" Tag="{Binding}" Click="MoveNameRuleUp_Click"
                                                        MinHeight="22" Padding="5,1" Margin="2,0" Background="Transparent" />
                                                <Button Grid.Column="4" Content="▼" ToolTip="Move filter down" Tag="{Binding}" Click="MoveNameRuleDown_Click"
                                                        MinHeight="22" Padding="5,1" Margin="2,0" Background="Transparent" />
                                                <Button Grid.Column="5" Content="🗑" ToolTip="Remove this filter" Tag="{Binding}" Click="DeleteNameRule_Click"
                                                        MinHeight="22" Padding="5,1" Margin="2,0,0,0" Background="Transparent" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Grid.Row="2" Orientation="Horizontal">
                                    <Button Content="Remove selected" Style="{StaticResource SecondaryButton}" Click="RemoveNameRule_Click" />
                                    <Button Content="Clear all" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="ClearNameRules_Click" />
                                </StackPanel>
                            </Grid>
                        </GroupBox>
                        <GroupBox Grid.Column="2" Header="Case and cleanup" Margin="8,0,0,0" Padding="10">
                            <StackPanel>
                                <TextBlock Text="Filename letter case" Margin="0,0,0,6" />
                                <RadioButton x:Name="CaseNoChangeRadio" GroupName="FilenameCase" Content="No case change" IsChecked="True" Margin="0,0,0,6" />
                                <RadioButton x:Name="CaseLowerRadio" GroupName="FilenameCase" Content="Make all lowercase" Margin="0,0,0,6" />
                                <RadioButton x:Name="CaseUpperRadio" GroupName="FilenameCase" Content="Make all uppercase" Margin="0,0,0,6" />
                                <WrapPanel Margin="0,12,0,4">
                                    <CheckBox x:Name="RemoveNumbersCheckBox" Content="Remove numbers" />
                                    <CheckBox x:Name="RemoveLettersCheckBox" Content="Remove letters" />
                                </WrapPanel>
                                <WrapPanel Margin="0,4">
                                    <CheckBox x:Name="RemoveSpacesCheckBox" Content="Remove spaces" />
                                    <CheckBox x:Name="RemoveSymbolsCheckBox" Content="Remove symbols" />
                                </WrapPanel>
                            </StackPanel>
                        </GroupBox>
                    </Grid>
                </TabItem>

                <TabItem Header="Split, trim and extension">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <GroupBox Grid.Column="0" Header="Split filename by character" Margin="0,0,8,0" Padding="10">
                            <StackPanel>
                                <CheckBox x:Name="SplitEnabledCheckBox" Content="Split filename" />
                                <TextBlock Text="Split character or delimiter" Margin="0,10,0,4" /><ComboBox x:Name="SplitDelimiterTextBox" IsEditable="True" IsTextSearchEnabled="False" />
                                <CheckBox x:Name="SplitCaseSensitiveCheckBox" Content="Case-sensitive delimiter" Margin="0,7,0,0" />
                                <TextBlock Text="Items to keep (for example 1,3,5-7)" Margin="0,10,0,4" /><ComboBox x:Name="SplitItemsTextBox" Text="1" IsEditable="True" IsTextSearchEnabled="False" />
                                <TextBlock Text="Optional new join character" Margin="0,10,0,4" /><ComboBox x:Name="SplitJoinerTextBox" IsEditable="True" IsTextSearchEnabled="False" />
                            </StackPanel>
                        </GroupBox>
                        <StackPanel Grid.Column="1" Margin="8,0">
                            <GroupBox Header="Filename left trim" Padding="10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Action" /><ComboBox x:Name="LeftTrimActionComboBox" SelectedIndex="0"><ComboBoxItem Content="None" /><ComboBoxItem Content="Remove" /><ComboBoxItem Content="Keep" /></ComboBox></StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0"><TextBlock Text="Characters" /><ComboBox x:Name="LeftTrimCountTextBox" Text="0" IsEditable="True" IsTextSearchEnabled="False" /></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="Ignore first" /><ComboBox x:Name="LeftTrimIgnoreTextBox" Text="0" IsEditable="True" IsTextSearchEnabled="False" /></StackPanel>
                                </Grid>
                            </GroupBox>
                            <GroupBox Header="Filename right trim" Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Action" /><ComboBox x:Name="RightTrimActionComboBox" SelectedIndex="0"><ComboBoxItem Content="None" /><ComboBoxItem Content="Remove" /><ComboBoxItem Content="Keep" /></ComboBox></StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0"><TextBlock Text="Characters" /><ComboBox x:Name="RightTrimCountTextBox" Text="0" IsEditable="True" IsTextSearchEnabled="False" /></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="Ignore first" /><ComboBox x:Name="RightTrimIgnoreTextBox" Text="0" IsEditable="True" IsTextSearchEnabled="False" /></StackPanel>
                                </Grid>
                            </GroupBox>
                        </StackPanel>
                        <GroupBox Grid.Column="2" Header="Replace file extension" Margin="8,0,0,0" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <ComboBox x:Name="ExtensionFindTextBox" IsEditable="True" IsTextSearchEnabled="False" ToolTip="Extension without the dot" KeyDown="ExtensionRuleField_KeyDown" />
                                    <ComboBox x:Name="ExtensionReplaceTextBox" Grid.Column="1" IsEditable="True" IsTextSearchEnabled="False" Margin="6,0" ToolTip="New extension" KeyDown="ExtensionRuleField_KeyDown" />
                                    <Button Grid.Column="2" Content="Add" Style="{StaticResource SecondaryButton}" Click="AddExtensionRule_Click" />
                                    <WrapPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,7,0,0">
                                        <CheckBox x:Name="ExtensionRuleCaseSensitiveCheckBox" Content="Case-sensitive extension match" />
                                        <CheckBox x:Name="ExtensionRuleRegexCheckBox" Content="Regular expression" Margin="14,0,0,0" />
                                    </WrapPanel>
                                </Grid>
                                <ListBox x:Name="ExtensionRulesList" Grid.Row="1" Margin="0,8">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid MinWidth="250">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Display}" VerticalAlignment="Center" />
                                                <CheckBox Grid.Column="1" Content=".*" ToolTip="Treat this filter as a regular expression" Tag="{Binding}"
                                                          IsChecked="{Binding UseRegex, Mode=TwoWay}" Click="RuleOptionChanged_Click" Margin="7,0,2,0" />
                                                <Button Grid.Column="2" Content="↥" ToolTip="Load this filter into the fields above" Tag="{Binding}" Click="LoadExtensionRule_Click"
                                                        MinHeight="22" Padding="5,1" Margin="2,0" Background="Transparent" />
                                                <Button Grid.Column="3" Content="▲" ToolTip="Move filter up" Tag="{Binding}" Click="MoveExtensionRuleUp_Click"
                                                        MinHeight="22" Padding="5,1" Margin="2,0" Background="Transparent" />
                                                <Button Grid.Column="4" Content="▼" ToolTip="Move filter down" Tag="{Binding}" Click="MoveExtensionRuleDown_Click"
                                                        MinHeight="22" Padding="5,1" Margin="2,0" Background="Transparent" />
                                                <Button Grid.Column="5" Content="🗑" ToolTip="Remove this filter" Tag="{Binding}" Click="DeleteExtensionRule_Click"
                                                        MinHeight="22" Padding="5,1" Margin="2,0,0,0" Background="Transparent" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Grid.Row="2" Orientation="Horizontal">
                                    <Button Content="Remove selected" Style="{StaticResource SecondaryButton}" Click="RemoveExtensionRule_Click" />
                                    <Button Content="Clear all" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="ClearExtensionRules_Click" />
                                </StackPanel>
                            </Grid>
                        </GroupBox>
                    </Grid>
                </TabItem>

                <TabItem Header="Date and time">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <GroupBox Grid.Column="0" Header="Date source" Margin="0,0,8,0" Padding="10">
                            <StackPanel>
                                <CheckBox x:Name="UseCurrentDateTimeCheckBox" Content="Use current date and time" IsChecked="True" />
                                <TextBlock Text="Custom date" Margin="0,12,0,4" /><DatePicker x:Name="CustomDatePicker" />
                                <TextBlock Text="Custom time (HH:mm:ss)" Margin="0,10,0,4" /><ComboBox x:Name="CustomTimeTextBox" Text="00:00:00" IsEditable="True" IsTextSearchEnabled="False" />
                                <TextBlock Text="The selected components are appended to the filename. Use the suffix field for a leading separator." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,12,0,0" />
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Grid.Column="1" Header="Date in filename" Margin="8,0" Padding="10">
                            <StackPanel>
                                <WrapPanel><CheckBox x:Name="AddYearCheckBox" Content="Year" /><CheckBox x:Name="AddMonthCheckBox" Content="Month" /><CheckBox x:Name="AddDayCheckBox" Content="Day" /></WrapPanel>
                                <CheckBox x:Name="YearAtEndCheckBox" Content="Place year at end of date" Margin="0,12,0,0" />
                                <TextBlock Text="Date separator" Margin="0,12,0,4" /><ComboBox x:Name="DateSeparatorTextBox" Text="-" IsEditable="True" IsTextSearchEnabled="False" />
                                <TextBlock Text="Date and time separator" Margin="0,10,0,4" /><ComboBox x:Name="DateTimeSeparatorTextBox" Text="_" IsEditable="True" IsTextSearchEnabled="False" />
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Grid.Column="2" Header="Time in filename" Margin="8,0,0,0" Padding="10">
                            <StackPanel>
                                <WrapPanel><CheckBox x:Name="AddHourCheckBox" Content="Hour" /><CheckBox x:Name="AddMinuteCheckBox" Content="Minute" /><CheckBox x:Name="AddSecondCheckBox" Content="Seconds" /></WrapPanel>
                                <TextBlock Text="Time separator" Margin="0,12,0,4" /><ComboBox x:Name="TimeSeparatorTextBox" Text="-" IsEditable="True" IsTextSearchEnabled="False" />
                            </StackPanel>
                        </GroupBox>
                    </Grid>
                </TabItem>

                <TabItem Header="Consecutive numbering / lettering">
                    <Grid Margin="12">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0"><TextBlock Text="Sequence" Margin="0,0,0,4" /><ComboBox x:Name="SequenceKindComboBox" SelectedIndex="0"><ComboBoxItem Content="None" /><ComboBoxItem Content="Numbers" /><ComboBoxItem Content="Letters (A, B … AA)" /></ComboBox></StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0"><TextBlock Text="Start" Margin="0,0,0,4" /><ComboBox x:Name="SequenceStartTextBox" Text="1" IsEditable="True" IsTextSearchEnabled="False" /></StackPanel>
                        <StackPanel Grid.Column="2" Margin="8,0"><TextBlock Text="Number digits" Margin="0,0,0,4" /><ComboBox x:Name="SequenceDigitsTextBox" Text="2" IsEditable="True" IsTextSearchEnabled="False" /></StackPanel>
                        <StackPanel Grid.Column="3" Margin="8,0"><TextBlock Text="Separator" Margin="0,0,0,4" /><ComboBox x:Name="SequenceSeparatorTextBox" IsEditable="True" IsTextSearchEnabled="False" /></StackPanel>
                        <StackPanel Grid.Column="4" Margin="8,0,0,0"><TextBlock Text="Position" Margin="0,0,0,4" /><ComboBox x:Name="SequencePositionComboBox" SelectedIndex="1"><ComboBoxItem Content="Before filename" /><ComboBoxItem Content="After filename" /></ComboBox></StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <Border Grid.Row="5" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusTextBlock" Text="Choose a folder and preview your changes." VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                <Button Grid.Column="1" Content="Refresh preview" Style="{StaticResource SecondaryButton}" Margin="8,0" Click="PreviewButton_Click" />
                <Button x:Name="ApplyButton" Grid.Column="2" Content="Apply rename" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="ApplyButton_Click" IsEnabled="False" />
            </Grid>
        </Border>
        </Grid>
    </Grid>
</Window>
