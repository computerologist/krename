<Window x:Class="KRename.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KRename settings" Width="610" Height="430" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#F4F4F8" ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" Foreground="#29283A" />
            <TextBlock Text="Preferences are saved for future KRename sessions." Foreground="#6A687A" Margin="0,2,0,16" />

            <GroupBox Header="Operation log" Padding="12" Background="White">
                <StackPanel>
                    <CheckBox x:Name="EnableLoggingCheckBox" Content="Write successful rename and undo operations to a log" />
                    <TextBlock Text="Log file location" Margin="0,12,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="LogPathTextBox" />
                        <Button Grid.Column="1" Content="Browse…" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="BrowseLogButton_Click" />
                    </Grid>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Behaviour" Padding="12" Background="White" Margin="0,12,0,0">
                <StackPanel>
                    <CheckBox x:Name="ConfirmBeforeRenameCheckBox" Content="Ask for confirmation before applying a rename" Margin="0,0,0,8" />
                    <CheckBox x:Name="RememberLastFolderCheckBox" Content="Remember the last source folder and folder history" Margin="0,0,0,8" />
                    <CheckBox x:Name="RecurseByDefaultCheckBox" Content="Enable recurse into subfolders by default" />
                </StackPanel>
            </GroupBox>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Width="90" IsCancel="True" />
            <Button Content="Save" Style="{StaticResource PrimaryButton}" Width="90" Margin="8,0,0,0" Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
